    {{ template "header.tmpl" . }}

    <div class="container main p-5">
      <h2 class="mb-4">Create Poll</h2>
      <form id="createPollForm" action="/create" method="POST">
        <div class="input-group needs-validation">
          <label for="title" class="input-group-text required-label">Poll Title</label>
          <input
            type="text"
            class="form-control"
            name="title"
            placeholder="My Poll (max 250 characters)"
            maxlength="250"
            required
          >
        </div>
        <div class="input-group my-3">
          <label for="description" class="input-group-text">Description</label>
          <input
            type="text"
            name="description"
            class="form-control"
            placeholder="Description"
          >
        </div>
        <div class="input-group my-3">
          <label for="options" class="input-group-text required-label">Options</label>
          <select
            name="options"
            id="options"
            onChange="onOptionsChange()"
            class="form-select"
            data-bs-title="Ranked Choice must use custom options"
            data-bs-placement="top"
          >
            <option value="pass_fail" selected>Pass/Fail</option>
            <option value="pass-fail-conditional">
              Pass/Fail or Conditional
            </option>
            <option value="fail-conditional">Fail/Conditional</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div id="customOptions" class="d-none my-3">
          <label class="form-label">Custom Vote Options</label>
          <div id="optionList">
            <div class="input-group has-validation mb-2 option-row">
              <input type="text" name="customOptions" class="form-control" placeholder="input option here" disabled>
              <button type="button" class="btn btn-outline-secondary remove-option" aria-label="Remove option">&times;</button>
              <div class="invalid-feedback"></div>
            </div>
            <div class="input-group has-validation mb-2 option-row">
              <input type="text" name="customOptions" class="form-control" placeholder="input option here" disabled>
              <button type="button" class="btn btn-outline-secondary remove-option" aria-label="Remove option">&times;</button>
              <div class="invalid-feedback"></div>
            </div>
          </div>
          <template id="optionRowTemplate">
            <div class="input-group has-validation mb-2 option-row">
              <input type="text" name="customOptions" class="form-control" placeholder="input option here" disabled>
              <button type="button" class="btn btn-outline-secondary remove-option" aria-label="Remove option">&times;</button>
              <div class="invalid-feedback"></div>
            </div>
          </template>
          <button type="button" id="addOptionBtn" class="btn btn-primary" onclick="addOptionRow()">+ Add Option</button>
          <div id="maxOptionsNote" class="form-text d-none">Maximum of 50 options</div>
        </div>

        <h5 class="mt-4"><strong>Additional Settings</strong></h5>
        <div class="form-check form-switch fs-5">
          <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            name="allowWriteIn"
            value="true"
          >
          <label for="allowWriteIn" class="form-check-label">Allow Write-Ins</label>
        </div>
        <div class="form-check form-switch fs-5">
          <input
            class="form-check-input"
            type="checkbox"
            name="rankedChoice"
            id="rankedChoice"
            value="true"
            onchange="onRankedChange()"
          >
          <label for="rankedChoice" class="form-check-label">Ranked Choice Vote</label>
        </div>
        <div class="form-check form-switch fs-5">
          <input
            class="form-check-input"
            type="checkbox"
            name="hidden"
            value="true"
          >
          <label for="hidden" class="form-check-label">Hide Results Until Vote is Complete</label>
        </div>
        
        {{ if .EBoard }}
        <div id="eboard-options" class="my-4">
          <h5><strong>E-Board Options</strong></h5>
          <div class="form-check form-switch fs-5">
              <input
                class="form-check-input"
                type="checkbox"
                name="gatekeep"
                id="gatekeep"
                value="true"
                onchange="onGatekeepChange()"
              >
              <label for="gatekeep"> Gatekeep Required (Require Quorum, Limit Voters, Force Automatic Close)</label>
          </div>
          <div id="quorumPercentInput" class="input-group d-none w-auto my-3">
            <label for="quorumType" class="input-group-text">Quorum %</label>
            <input
              type="number"
              name="quorumType"
              id="quorumType"
              class="form-control"
              min="0"
              max="100"
              step="1"
              value="50"
            >
          </div>
          <div id="waivedUsers" class="input-group d-none my-3">
            <label for="waivedUsers" class="input-group-text">Waived Users</label>
            <input
              type="text"
              name="waivedUsers"
              class="form-control"
              placeholder="Comma separated list of usernames"
            >
          </div>
          <div class="form-check form-switch fs-5 my-2">
            <input
              class="form-check-input"
              type="checkbox"
              name="hideIneligible"
              value="true"
            >
            <label for="hidden" class="form-check-label">Hide Results for Members Who Cannot Vote</label>
          </div>
        </div>
        {{ end }}

        <input type="submit" class="btn btn-primary my-2" value="Create">
      </form>
    </div>

    <style>
      .required-label::after {
        content: " *";
        color: red;
      }
    </style>
    <script>
      const MAX_OPTIONS = 50;
      const optionsSelect = document.getElementById("options");
      const rankedChoice = document.getElementById("rankedChoice");
      const optionList = document.getElementById("optionList");
      const optionsTooltip = new bootstrap.Tooltip(optionsSelect, { trigger: 'hover focus' });
      optionsTooltip.disable();

      function disableTooltip() {
        optionsTooltip.hide();
        optionsTooltip.disable();
      }
      function onOptionsChange() {
        const isCustom = optionsSelect.value == "custom";
        document.getElementById("customOptions").classList.toggle('d-none', !isCustom);
        optionList.querySelectorAll('input').forEach(input => input.disabled = !isCustom);
        if (!isCustom && rankedChoice.checked) {
          rankedChoice.checked = false;
          disableTooltip();
        }
      }
      function onRankedChange() {
        if (rankedChoice.checked) {
          optionsSelect.value = "custom";
          onOptionsChange();
          optionsTooltip.enable();
        } else {
          disableTooltip();
        }
      }
      function updateOptionControls() {
        const rows = optionList.querySelectorAll('.option-row');
        const atMax = rows.length >= MAX_OPTIONS;
        document.getElementById("addOptionBtn").disabled = atMax;
        document.getElementById("maxOptionsNote").classList.toggle('d-none', !atMax);
        rows.forEach(row => row.querySelector('.remove-option').disabled = rows.length == 1);
      }
      function addOptionRow() {
        if (optionList.querySelectorAll('.option-row').length >= MAX_OPTIONS) {
          return;
        }
        const row = document.getElementById("optionRowTemplate").content.firstElementChild.cloneNode(true);
        const input = row.querySelector('input');
        input.disabled = optionsSelect.value != "custom";
        optionList.appendChild(row);
        input.focus();
        updateOptionControls();
      }
      function validateCustomOptions() {
        const inputs = Array.from(optionList.querySelectorAll('input'));
        const seen = new Set();
        let valid = true;
        inputs.forEach(input => input.classList.remove('is-invalid'));
        const markInvalid = (input, message) => {
          input.classList.add('is-invalid');
          input.parentElement.querySelector('.invalid-feedback').textContent = message;
          valid = false;
        };
        inputs.forEach(input => {
          const value = input.value.trim().toLowerCase();
          if (value == "") {
            return;
          }
          if (seen.has(value)) {
            markInvalid(input, "Duplicate option");
          }
          seen.add(value);
        });
        if (seen.size == 0) {
          markInvalid(inputs[0], "Enter at least one option");
        }
        return valid;
      }

      optionList.addEventListener('click', event => {
        const button = event.target.closest('.remove-option');
        if (!button || optionList.querySelectorAll('.option-row').length <= 1) {
          return;
        }
        const row = button.closest('.option-row');
        const neighbor = row.previousElementSibling || row.nextElementSibling;
        row.remove();
        neighbor.querySelector('input').focus();
        updateOptionControls();
      });

      optionList.addEventListener('keydown', event => {
        if (event.key == "Enter" && event.target.matches('input')) {
          event.preventDefault();
          addOptionRow();
        }
      });

      optionList.addEventListener('input', event => event.target.classList.remove('is-invalid'));
      document.getElementById("createPollForm").addEventListener('submit', event => {
        if (optionsSelect.value == "custom" && !validateCustomOptions()) {
          event.preventDefault();
          optionList.querySelector('.is-invalid').focus();
        }
      });

      onOptionsChange();
      if (rankedChoice.checked) {
        optionsTooltip.enable();
      }
      updateOptionControls();

      function onGatekeepChange(){
        const gatekeepBox = document.getElementById("gatekeep");
        const waivedUsers = document.getElementById("waivedUsers");
        const quorumType = document.getElementById("quorumPercentInput");
        if (gatekeepBox.checked){
          waivedUsers.classList.remove('d-none');
          quorumType.classList.remove('d-none');
        } else {
          waivedUsers.classList.add('d-none');
          quorumType.classList.add('d-none');
        }
      }

      (() => {
        'use strict'

        // Fetch all the forms we want to apply custom Bootstrap validation styles to
        const forms = document.querySelectorAll('.needs-validation')

        // Loop over them and prevent submission
        Array.from(forms).forEach(form => {
          form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }

            form.classList.add('was-validated')
          }, false)
        })
      })()
    </script>
  </body>
</html>
